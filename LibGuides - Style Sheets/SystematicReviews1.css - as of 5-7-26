@charset "utf-8";
/* CSS Document */
#s-lg-guide-main {
	font-size: 16px;
}

 #s-lg-guide-name {
	 background-image: URL(https://libapps.s3.amazonaws.com/accounts/259365/images/bacteria-gd68a79920_1920.jpg); 
	 color: #fff; 
	 font-weight: 600; 
	 padding:20px 10px;
}  

.protocol h3 {
	color: #000; 
	font-weight: 600;
	font-size: 1.3rem;
}

/*Accordion*/
.panel-group .panel { 
	border-radius: 0;
}
.panel-default>.panel-heading {
	background-color: #f5f5f5;
}

/*Change link colors*/
a {
	color: #0033A0;
}
a:hover {
	color: #1B365D; 
	text-decoration: underline;
}

/*button for intake form*/
.button {
	background-color: #B1C9E8;
    padding: 20px;
    color: #000;
	width: 100%;
    cursor: pointer;
    display: inline-block;
    font-weight: 600;
    text-transform: uppercase;
    margin: 5px;
    text-wrap: wrap;
    text-align: center;
    touch-action: manipulation;
    vertical-align: middle;
    line-height: 1.4;
}

.button1 {
	background-color: #B1C9E8; 
	color: #000; 
 	border: 0;
}

.button1:hover {
	background-color: #008CBA;
	color: #fff;
}

.button2 {
	background-color: #B1C9E8; 
	color: #000; 
	border: 0;
}

.button2:hover {
  background-color: #008CBA;
  color: #fff;
}
/*fixes top of buttons on homepage*/
#s-lg-box-27901829 {
    margin-top: -50px;
}

.HeaderLeft {
	float:left; 
	width: 25%; 
}
.HeaderRight {
	float:right; 
	width: 74%;
}

.RolesLeft {
	float:left; 
	width: 25%; 
	margin-top: 20px;
}

.RolesRight {
	float:right; 
	width: 74%;
}
.video img {
	text-align: center; 
	margin: 0 auto; 
	display: block; 
	width:100%;
}

#s-lg-box-27902583, #s-lg-box-27909669, #s-lg-box-27909796, #s-lg-box-27909827, #s-lg-box-27909850, #s-lg-box-27909890{
	background-color: #efefef; 
	padding: 15px;
}

/*buttons left align*/
#buttons .btn {display: flex;}

.TutorialBoxGray {background-color: #efefef; padding: 15px;}

/*Check Mark*/
.list-display li {
	margin-bottom:.4rem;
}
.list-checkmarks {
	padding-left:1.5rem;
}
.list-checkmarks li {
	list-style-type:none; 
	padding-left:1rem;
}
.list-checkmarks li:before {
	font-family: 'FontAwesome'; 
	content: "\f00c"; 
	margin:0 10px 0 -28px; 
	color: #17aa1c;
}
.list-cons{
	padding-left:1.5rem;
}
.list-cons li {
	list-style-type:none;
	padding-left:1.2rem;
}
.list-cons li:before {
	font-family: 'FontAwesome'; 
	content: "\f00d"; 
	margin:0 10px 0 -28px; 
	color: #de3333;
}

/*Homepage Librarian Roles*/
#roles1 {
	float: left;
	width: 60%
}

#roles2 {
	float: right;
	width: 38%;
}

#consultant {
    height: 250px;
    width: 100%;
    background: rgba(177, 201, 232, 0.3);
    padding: 20px 10px;
}

#facilitator {
    height: 250px;
    width: 100%;
    background: rgba(177, 201, 232, 0.6);
    padding: 20px 10px;
	margin-top: 20px;
}

#collaborator {
    height: 250px;
    width: 100%;
    background: rgba(177, 201, 232, 0.8);
    padding: 20px 10px;
	margin: 20px 0;
}

@media (max-width: 768px) {
	#roles1 {
		width: 100%;
	}
	#roles2 {
		width: 100%;
	}
}
@media (max-width: 768px) {
	#facilitator {
		height: 400px;
	}
	#collaborator {
		height: 425px;
	}
}